# Backend. Defaults to the production API if unset.
VITE_API_URL=https://blorbmart-tr1i.onrender.com

# Web push.
#
# Firebase Console > Project settings > Cloud Messaging > Web configuration >
# "Web Push certificates" > generate a key pair, then paste the public key.
#
# Without it the app still works: riders see jobs the instant they arrive via
# the Firestore listener whenever the app is open. What they lose is the
# alert that reaches a phone in a pocket, which on iOS only works at all once
# the app has been installed to the home screen.
VITE_FIREBASE_VAPID_KEY=
